# ------------------------------------------------------------
# Android project .gitignore
# Mirror-style private repository version
# Keeps important config and final outputs
# ------------------------------------------------------------

# -----------------------
# OS / editor junk
# -----------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.desktop
.directory

# -----------------------
# IDE files
# -----------------------
.idea/
*.iml
*.ipr
*.iws

.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# -----------------------
# Gradle / build cache junk
# Keep transient build/cache ignored
# -----------------------
.gradle/
**/.gradle/
build/
**/build/
out/
captures/
.externalNativeBuild/
.cxx/

# -----------------------
# Logs / temp
# -----------------------
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
hs_err_pid*
replay_pid*

# -----------------------
# Archives only if temporary
# Remove these lines if you intentionally store zip exports
# -----------------------
# *.zip
# *.tar
# *.tar.gz
# *.7z
# *.rar

# ------------------------------------------------------------
# IMPORTANT:
# We are intentionally NOT ignoring these, because this repo
# is meant to preserve full working configuration:
#
# - local.properties
# - .env
# - google-services.json
# - key.properties
# - signing.properties
# - *.apk
# - *.aab
# - release artifacts
#
# If you want to exclude any of them later, do it explicitly.
# ------------------------------------------------------------




